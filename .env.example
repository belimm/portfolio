# Server-side only. Where the portfolio reaches the API (internal URL is fine on Coolify).
API_URL=http://localhost:8000
# Same value as PORTFOLIO_SECRET in backend/.env (use a long random string in production)
PORTFOLIO_SECRET=dev-secret

# Optional: also send an email for each contact form message.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
