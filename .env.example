# ---- Admin sign-in -------------------------------------------------------------
# Generate all of these with: npm run admin:credentials -- --email you@example.com
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional but recommended: 6-digit codes from an authenticator app
ADMIN_TOTP_SECRET=

# ---- Storage --------------------------------------------------------------------
# Vercel Blob (Storage tab in the Vercel project). Empty = use the local .data/ folder.
BLOB_READ_WRITE_TOKEN=
# Match the store: "private" (recommended) or "public"
BLOB_ACCESS=private

# ---- Rate limiting across serverless instances (optional locally) -----------------
# Upstash Redis from the Vercel Marketplace sets these (or the KV_REST_API_* equivalents).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Contact form notifications (optional, server-side) -----------------------------
# Telegram: create a bot with @BotFather, then run `npm run telegram:setup` to find the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Any webhook (Discord, Slack, n8n, Zapier…): receives the message as JSON.
CONTACT_WEBHOOK_URL=
# Optional: signs the webhook body (header X-Signature-256: sha256=<hmac>).
CONTACT_WEBHOOK_SECRET=
# How notifications name this project (the Telegram chat may be shared with other projects).
NOTIFY_PROJECT_NAME=Portfolio
NOTIFY_PROJECT_TAG=portfolio
# Used for the site name and the "Open the inbox" link in notifications.
SITE_URL=https://www.belim.dev

# ---- GitHub section (optional) ----------------------------------------------
# A fine-grained token with no extra permissions is enough (github.com/settings/tokens?type=beta).
# Without it the GitHub section is left out. The login comes from the profile's GitHub URL.
GITHUB_TOKEN=
GITHUB_ACTIVITY_LOGIN=

# ---- Optional: also email each contact form message (EmailJS, from the browser) -----
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
